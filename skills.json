      "license": "MIT",
      "paths": {
        "skills": "skills",
        "LICENSE": "LICENSE"
      },
      "skills": [
        "better-interface",
        "better-accessibility",
        "better-colors",
        "better-layout",
        "better-typography",
        "better-ui",
        "better-writing",
        "interface-review",
        "break",
        "variant",
        "explain-interface"
      ],
      "scope": "user",
      "licenseFile": "LICENSE"
    },
    {
      "id": "impeccable",
      "repository": "https://github.com/pbakaus/impeccable",
      "homepage": "https://impeccable.style",
      "author": "Paul Bakaus",
      "license": "Apache-2.0",
      "paths": {
        "skills": "plugin/skills",
        "agents": "plugin/agents",
        "hooks": "plugin/hooks",
        "LICENSE": "LICENSE",
        "NOTICE.md": "NOTICE.md"
      },
