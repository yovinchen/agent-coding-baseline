      "paths": {
        "skills/web-design-guidelines": "skills/web-design-guidelines",
        "README.md": "README.md"
      },
      "skills": [
        "web-design-guidelines"
      ],
      "scope": "user"
    }
  ],
  "own": [
    {
      "name": "commit",
